{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStringEnvironmentVariable": "ConnectionStrings__DefaultConnection",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "PathBase": {
    "Path": "",
    "UseForwardedHeaders": true,
    "ForwardedHeaders": "XForwardedFor,XForwardedProto,XForwardedHost"
  },
  "Authentication": {
    "Mode": "Local",
    "RequireConfirmedAccount": false,
    "AllowSelfRegistration": false,
    "Cookie": {
      "Name": ".OtTime.Auth",
      "ExpireTimeSpanHours": 12,
      "SlidingExpiration": true,
      "SecurePolicy": "Always"
    },
    "Password": {
      "RequiredLength": 12,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 4
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 15
    }
  },
  "Time": {
    "OrganizationTimeZone": "UTC",
    "DaylightSavingPolicy": "UseTimeZoneRules"
  },
  "Scheduling": {
    "Enabled": true,
    "WorkerPollIntervalSeconds": 30,
    "LeaseDurationSeconds": 300,
    "RetryDelaySeconds": 300,
    "MaximumRetryAttempts": 3,
    "DefaultTimeZone": "UTC"
  },
  "Artifacts": {
    "StorageRoot": "",
    "StorageRootEnvironmentVariable": "OtTime__Artifacts__StorageRoot",
    "AllowedDestinationRoots": [],
    "RetentionDays": 90,
    "ExecutionHistoryRetentionDays": 365,
    "DeleteExpiredArtifacts": true
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "FromAddress": "",
    "FromDisplayName": "OtTime",
    "Username": "",
    "Password": "",
    "PasswordEnvironmentVariable": "OtTime__Smtp__Password",
    "AllowedRecipientDomains": []
  },
  "Bootstrap": {
    "Enabled": true,
    "AdministratorEmail": "",
    "AdministratorPassword": "",
    "AdministratorEmailEnvironmentVariable": "OtTime__Bootstrap__AdministratorEmail",
    "AdministratorPasswordEnvironmentVariable": "OtTime__Bootstrap__AdministratorPassword",
    "RequirePasswordChange": true,
    "DisableAfterSuccessfulBootstrap": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}