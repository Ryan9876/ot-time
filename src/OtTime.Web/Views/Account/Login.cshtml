@model OtTime.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = Model.RequiresPasswordChange ? "Change temporary password" : "Sign in";
}

<section class="auth-page" aria-labelledby="page-title">
    <div class="auth-card">
        <header class="auth-card__header">
            <h1 id="page-title">@(Model.RequiresPasswordChange ? "Change your password" : "Sign in")</h1>
            @if (Model.RequiresPasswordChange)
            {
                <p>Your temporary password must be changed before you can continue.</p>
            }
            else
            {
                <p>Use the account provided by your administrator.</p>
            }
        </header>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="form-group">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="UserName" class="field-validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">@(Model.RequiresPasswordChange ? "Temporary password" : "Password")</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            @if (Model.RequiresPasswordChange)
            {
                <div class="form-group">
                    <label asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="field-validation"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
                </div>
            }
            else
            {
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block">
                @(Model.RequiresPasswordChange ? "Change password and sign in" : "Sign in")
            </button>
        </form>
    </div>
</section>